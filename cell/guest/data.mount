[Unit]
Description=Cell data volume
# Not part of local-fs.target: otherwise shutdown unmounts it only after every
# unit ordered after local-fs.target has stopped, which measured at ~350 ms.
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
BindsTo=dev-disk-by\x2did-virtio\x2dcldata.device
Requires=cell-restore-hook.service systemd-fsck@dev-disk-by\x2did-virtio\x2dcldata.service
After=dev-disk-by\x2did-virtio\x2dcldata.device cell-restore-hook.service systemd-fsck@dev-disk-by\x2did-virtio\x2dcldata.service

[Mount]
What=/dev/disk/by-id/virtio-cldata
Where=/data
Type=ext4
Options=noatime,nodev,nosuid
